# Copy this file to .env and fill in your own values. Never commit .env.

# --- LLM backend (any OpenAI-compatible endpoint) ---
# Switching backend is a change in this block only (see docs/deploy.md):
#   OpenAI (temporary)         LLM_BASE_URL=https://api.openai.com/v1
#   Ollama, without Docker     LLM_BASE_URL=http://localhost:11434/v1
#   Ollama on the Docker host  LLM_BASE_URL=http://host.docker.internal:11434/v1
#   Ollama in compose          LLM_BASE_URL=http://ollama:11434/v1   (make up-ollama)
# A local open-weight model is slower: raise LLM_TIMEOUT_SECONDS (e.g. 180) and
# JOB_TIMEOUT_SECONDS (e.g. 1200), and keep K_CONSUMERS <= OLLAMA_NUM_PARALLEL (1-2 on 24 GB).
LLM_BASE_URL=http://localhost:11434/v1
# Local Ollama accepts any non-empty value; use the real key for the FBK server / OpenAI
LLM_API_KEY=replace-me
# Model name exactly as the server exposes it (e.g. the tag shown by `ollama list`)
LLM_MODEL=replace-me
LLM_TIMEOUT_SECONDS=60

# --- Job processing ---
# Jobs processed in parallel
K_CONSUMERS=2
# Hard cap on LLM/tool steps per agent loop
MAX_AGENT_STEPS=10
# Seconds before uploaded CVs and finished jobs are deleted
JOB_TTL_SECONDS=3600
# Jobs allowed to wait in the queue; beyond this the API answers 503
MAX_QUEUE=100
# Seconds before a running job is stopped and marked as failed
JOB_TIMEOUT_SECONDS=600
# The same CV file with the same job description gets the same answer: the earlier job is
# returned instead of running the model again. Set to false to run it again each time
# (for example to measure how much the score varies between runs).
REUSE_RESULTS=true

# --- Files and services ---
# docker-compose.yml overrides these two for its containers
STORAGE_DIR=data
MCP_GATEWAY_URL=http://127.0.0.1:8765/mcp

# --- Ollama in compose only (make up-ollama) ---
# Requests the model serves at once, and how long it stays in VRAM between jobs
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=30m
